rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public status projection contains no credentials or payment secrets.
    // Only the backend service account may write it.
    match /paymentStatus/{orderId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
